<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>1.0.0</Version><ApplicationIcon>Assets/pcinema.ico</ApplicationIcon><OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><PlatformTarget>x64</PlatformTarget><VlcWindowsX86Enabled>false</VlcWindowsX86Enabled><VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled><VlcWindowsX64Enabled>true</VlcWindowsX64Enabled><ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.9.4" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" />
  </ItemGroup>
<ItemGroup><Content Include="../licenses/*" Link="licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" /><Content Include="../THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" /></ItemGroup><ItemGroup><EmbeddedResource Include="../.secrets/tmdb.token" LogicalName="PCinema.TmdbToken" Condition="Exists('../.secrets/tmdb.token')" /></ItemGroup><ItemGroup><Resource Include="Assets/tmdb-logo.png" /><Resource Include="Assets/pcinema-logo.png" /><Resource Include="Assets/pcinema.ico" /></ItemGroup><ItemGroup><Using Remove="System.Windows.Forms"/><Using Remove="System.Drawing"/></ItemGroup><ItemGroup><ProjectReference Include="../PCinema.ModuleApi/PCinema.ModuleApi.csproj" /></ItemGroup><ItemGroup><Content Include="../.secrets/google-oauth.json" Link="google-oauth.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('../.secrets/google-oauth.json')" /><Content Include="../docs/GOOGLE-SETUP.md" Link="docs/GOOGLE-SETUP.md" CopyToOutputDirectory="PreserveNewest" /></ItemGroup></Project>


