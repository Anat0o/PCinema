<local:Screen x:Class="PCinema.PlayerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PCinema" xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF" Background="Black" Focusable="True">
<Grid><vlc:VideoView x:Name="Video">
<Grid x:Name="Overlay" Focusable="True" TextElement.Foreground="{DynamicResource App.Text}" TextElement.FontFamily="{DynamicResource App.Font}" TextElement.FontSize="14" Background="#01000000" MouseMove="Activity" MouseLeftButtonDown="VideoClick" MouseWheel="VideoWheel" PreviewKeyDown="OverlayKey">
<Grid x:Name="PauseInfo" Visibility="Collapsed" IsHitTestVisible="False" ClipToBounds="True" Opacity="0">
<local:PauseArtwork x:Name="PauseArt"><local:PauseArtwork.CacheMode><BitmapCache/></local:PauseArtwork.CacheMode><local:PauseArtwork.RenderTransform><TranslateTransform x:Name="PauseArtOffset"/></local:PauseArtwork.RenderTransform></local:PauseArtwork>
<Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#B8080A0E" Offset="0"/><GradientStop Color="#88080A0E" Offset="0.36"/><GradientStop Color="#18080A0E" Offset="0.68"/><GradientStop Color="#00080A0E" Offset="1"/></LinearGradientBrush></Border.Background></Border>
<Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#70080A0E" Offset="0"/><GradientStop Color="#00080A0E" Offset="0.35"/><GradientStop Color="#D9080A0E" Offset="1"/></LinearGradientBrush></Border.Background></Border>
<Viewbox Margin="72,120,72,150" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center">
<StackPanel x:Name="PauseCopy" Width="620"><StackPanel.RenderTransform><TranslateTransform x:Name="PauseCopyOffset"/></StackPanel.RenderTransform>
<StackPanel Orientation="Horizontal" Margin="0,0,0,24"><Border Width="28" Height="2" Background="#ECE3D1" VerticalAlignment="Center" Margin="0,0,14,0"/><TextBlock Text="НА ПАУЗЕ" Foreground="#D9D4CB" FontSize="12" FontWeight="SemiBold"/></StackPanel>
<TextBlock x:Name="PauseTitle" FontSize="48" FontWeight="Bold" TextWrapping="Wrap" MaxHeight="174" TextTrimming="CharacterEllipsis"/>
<TextBlock x:Name="PauseEpisode" FontSize="18" Foreground="#E4DED4" TextWrapping="Wrap" Margin="0,18,0,0"/>
<Border Width="44" Height="1" Background="#65FFFFFF" HorizontalAlignment="Left" Margin="0,24,0,0"/>
<TextBlock x:Name="PauseDescription" FontSize="17" LineHeight="28" Foreground="#D1D1D4" TextWrapping="Wrap" MaxHeight="168" TextTrimming="CharacterEllipsis" Margin="0,20,0,0"/>
<TextBlock Text="ПРОБЕЛ ИЛИ ЩЕЛЧОК · ПРОДОЛЖИТЬ" Foreground="#999CA4" FontSize="11" Margin="0,30,0,0"/>
</StackPanel></Viewbox>
</Grid>
<Grid x:Name="Controls">
<Border VerticalAlignment="Top" Height="140"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#C0000000" Offset="0"/><GradientStop Color="#00000000" Offset="1"/></LinearGradientBrush></Border.Background></Border>
<Grid x:Name="TopHeader" VerticalAlignment="Top" Margin="28,20"><Button Style="{StaticResource IconButton}" Content="&#xE72B;" Click="NavigateBack" HorizontalAlignment="Left" Background="Transparent" ToolTip="Назад · Escape"/><StackPanel HorizontalAlignment="Center" MaxWidth="600"><TextBlock x:Name="EpisodeTitle" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="EpisodeNumber" Foreground="#CCCCCC" TextAlignment="Center" Margin="0,5,0,0"/></StackPanel></Grid>
<Border x:Name="BottomControls" VerticalAlignment="Bottom" Padding="20,14,20,12" Margin="16,0,16,16" CornerRadius="16" BorderBrush="{DynamicResource App.Border}" BorderThickness="1"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#7010141C" Offset="0"/><GradientStop Color="#B010141C" Offset="1"/></LinearGradientBrush></Border.Background>
<StackPanel><Button x:Name="CancelAutoplayButton" Content="Отменить автоплей" Click="CancelAutoplay" Visibility="Collapsed" HorizontalAlignment="Left"/><TextBlock x:Name="PlayerStatus" Foreground="#C7C9CC" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
<Slider IsMoveToPointEnabled="True" x:Name="Position" Minimum="0" Maximum="1" PreviewMouseLeftButtonDown="SeekStart" PreviewMouseLeftButtonUp="SeekEnd" ValueChanged="SeekChanged" ToolTip="Позиция воспроизведения"/>
<Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel Orientation="Horizontal">
<Button x:Name="PauseButton" Style="{StaticResource IconButton}" Content="&#xE768;" Click="Pause" Background="Transparent" ToolTip="Пауза · пробел"/>
<Button x:Name="RewindButton" Style="{StaticResource IconButton}" Content="&#xE7A7;" Click="Back" Background="Transparent" ToolTip="Назад 10 секунд"/>
<Button x:Name="ForwardButton" Style="{StaticResource IconButton}" Content="&#xE7A6;" Click="Forward" Background="Transparent" ToolTip="Вперёд 10 секунд"/>
<Button x:Name="MuteButton" Style="{StaticResource IconButton}" Content="&#xE767;" Click="Mute" Background="Transparent" ToolTip="Выключить звук"/>
<Slider x:Name="VolumeSlider" Width="70" Minimum="0" Maximum="100" Value="80" ValueChanged="Volume" VerticalAlignment="Center" ToolTip="Громкость"/>
<TextBlock x:Name="Clock" VerticalAlignment="Center" Margin="12,0" FontSize="12"/>
</StackPanel>
<StackPanel Grid.Column="2" Orientation="Horizontal">
<Button x:Name="NextButton" Style="{StaticResource IconButton}" Content="&#xE893;" Click="Next" Background="Transparent" ToolTip="Следующая серия"/>
<Button x:Name="EpisodesButton" Style="{StaticResource IconButton}" Content="&#xE8FD;" Click="ShowEpisodes" Background="Transparent" ToolTip="Серии"/>
<Button x:Name="TracksButton" Style="{StaticResource IconButton}" Content="&#xE713;" Click="ShowTracks" Background="Transparent" ToolTip="Звук и субтитры"/>
<Button x:Name="PipButton" Style="{StaticResource IconButton}" Content="&#xE8A7;" Click="PictureInPicture" Background="Transparent" ToolTip="Картинка в картинке · P"/>
<Button Style="{StaticResource IconButton}" Content="&#xE740;" Click="Fullscreen" Background="Transparent" ToolTip="Полный экран · F"/>
</StackPanel></Grid></StackPanel></Border>
</Grid>
<Border x:Name="MenuPanel" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Center" Width="380" MaxHeight="560" Margin="28,80,28,100" CornerRadius="20" Background="#C4171B24" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" Padding="24">
<DockPanel><Button DockPanel.Dock="Top" Content="Закрыть · Esc" Click="CloseMenu" HorizontalAlignment="Right"/>
<ScrollViewer x:Name="TrackPanel" VerticalScrollBarVisibility="Auto"><StackPanel>
<TextBlock Text="Звук и субтитры" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/><TextBlock Text="Аудиодорожка"/><ComboBox x:Name="AudioTracks" SelectionChanged="AudioChanged"/><TextBlock Text="Субтитры" Margin="0,12,0,0"/><ComboBox x:Name="SubtitleTracks" SelectionChanged="SubtitleChanged"/><Button Content="Открыть SRT / ASS" Click="LoadSubtitle" Margin="0,12,0,18"/>
<TextBlock Text="Декодирование видео"/><ComboBox x:Name="Decoding" SelectionChanged="DecodingChanged" Margin="0,6,0,14"/>
<TextBlock Text="Оформление субтитров" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
<TextBlock Text="Размер шрифта · 12–160 px"/><DockPanel><TextBox x:Name="SubtitleSize" Width="85" DockPanel.Dock="Right" TextChanged="SizeTextChanged" ToolTip="Размер шрифта числом от 12 до 160"/><Slider x:Name="SubtitleSizeSlider" Minimum="12" Maximum="160" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="SizeSliderChanged" Margin="0,0,12,0"/></DockPanel>
<TextBlock Text="Шрифт"/><ComboBox x:Name="SubtitleFont" SelectionChanged="AppearanceChanged"/>
<TextBlock Text="Цвет текста" Margin="0,12,0,8"/><UniformGrid x:Name="SubtitlePalette" Columns="8"/><TextBox x:Name="SubtitleColor" ToolTip="Цвет в формате #RRGGBB, например #FFE066" MaxLength="7" TextChanged="AppearanceChanged"/><TextBlock Text="Выберите цвет в палитре или введите HEX-код." Foreground="#B9BBBF" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
<TextBlock Text="Стиль"/><ComboBox x:Name="SubtitleStyle" SelectionChanged="AppearanceChanged"/>
<CheckBox x:Name="SubtitleBold" Content="Полужирный" Foreground="{DynamicResource App.Text}" Margin="0,8" Checked="AppearanceChanged" Unchecked="AppearanceChanged"/>
<Border x:Name="SubtitlePreviewBackground" Background="#B4000000" CornerRadius="8" Padding="10" Margin="0,8"><TextBlock x:Name="SubtitlePreview" Text="Пример субтитров" TextAlignment="Center" TextWrapping="Wrap"/></Border>
<Button Content="Применить оформление" Click="ApplyAppearance"/>
<TextBlock Text="Сохраняется для следующих видео. ASS со своим оформлением и субтитры-картинки могут не измениться." Foreground="#B9BBBF" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
</StackPanel></ScrollViewer>
<ListBox x:Name="EpisodeList" Visibility="Collapsed" MaxHeight="300" MouseDoubleClick="SelectEpisode"/>
</DockPanel></Border>
</Grid></vlc:VideoView></Grid>
</local:Screen>

