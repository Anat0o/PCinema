<Window x:Class="PCinema.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PCinema" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Style="{StaticResource {x:Type Window}}" Title="PCinema" Icon="Assets/pcinema.ico" Width="1280" Height="860" MinWidth="850" MinHeight="600" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" PreviewKeyDown="KeyPressed">
<shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/></shell:WindowChrome.WindowChrome>
<Window.Resources>
<Style x:Key="NavigationButton" TargetType="Button">
<Setter Property="Foreground" Value="{DynamicResource App.Text}"/><Setter Property="Background" Value="Transparent"/><Setter Property="FontFamily" Value="Segoe Fluent Icons"/><Setter Property="FontSize" Value="20"/><Setter Property="Width" Value="44"/><Setter Property="Height" Value="44"/><Setter Property="Margin" Value="2,0"/><Setter Property="Cursor" Value="Hand"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid><Border x:Name="Glass" CornerRadius="14" Background="{DynamicResource App.Glass}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" Opacity="0"/><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/><Border x:Name="Active" Background="{DynamicResource App.Text}" Height="2" Width="14" CornerRadius="1" VerticalAlignment="Bottom" Margin="0,0,0,4" Visibility="Collapsed"/></Grid><ControlTemplate.Triggers>
<Trigger Property="IsMouseOver" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Glass" Storyboard.TargetProperty="Opacity" To="0.85" Duration="{x:Static local:Motion.Hover}"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Glass" Storyboard.TargetProperty="Opacity" To="0" Duration="{x:Static local:Motion.Hover}"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger>
<Trigger Property="Tag" Value="Active"><Setter TargetName="Active" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Glass" Property="BorderBrush" Value="{DynamicResource App.Text}"/><Setter TargetName="Active" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.65"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
</ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>

<local:LocalImageConverter x:Key="LocalImage"/>
<DataTemplate x:Key="Card">
<Button Click="OpenSeries" Width="200" Height="300" Padding="0" Margin="0,8,16,14" Background="{DynamicResource App.Panel}" ToolTip="{Binding Title}">
<Button.Template><ControlTemplate TargetType="Button">
<Grid x:Name="CardRoot" RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
<Border CornerRadius="16" ClipToBounds="True" local:AsyncImage.Path="{Binding Poster}"/>
<Border CornerRadius="16"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00202329" Offset="0"/><GradientStop Color="#E00B0D12" Offset="1"/></LinearGradientBrush></Border.Background><StackPanel VerticalAlignment="Bottom" Margin="14"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Subtitle}" Foreground="#B9BBBF" FontSize="12" Margin="0,6,0,0"/></StackPanel></Border>
<Border x:Name="Hover" CornerRadius="16" Background="#88000000" Opacity="0"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><Border Background="White" CornerRadius="30" Width="54" Height="54"><TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons" Foreground="Black" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Открыть сериал" Margin="0,12,0,0" FontSize="12"/></StackPanel></Border>
<ProgressBar Value="{Binding Progress,Mode=OneWay}" Height="3" Maximum="100" VerticalAlignment="Bottom" Margin="12,0,12,7" Foreground="{DynamicResource App.Text}" Background="#30FFFFFF" BorderThickness="0"/>
</Grid>
<ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="{x:Static local:Motion.Hover}"/><DoubleAnimation Storyboard.TargetName="CardRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.025" Duration="{x:Static local:Motion.Hover}"/><DoubleAnimation Storyboard.TargetName="CardRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.025" Duration="{x:Static local:Motion.Hover}"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="{x:Static local:Motion.Hover}"/><DoubleAnimation Storyboard.TargetName="CardRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="{x:Static local:Motion.Hover}"/><DoubleAnimation Storyboard.TargetName="CardRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="{x:Static local:Motion.Hover}"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="1"/></Trigger></ControlTemplate.Triggers>
</ControlTemplate></Button.Template></Button></DataTemplate>
<DataTemplate x:Key="ResumeCard"><Button Click="OpenSeries" Width="300" Height="224" Margin="0,0,16,8" Padding="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ToolTip="{Binding Title}"><Grid Width="300"><Grid.RowDefinitions><RowDefinition Height="169"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border CornerRadius="16" Background="{DynamicResource App.Panel}" local:AsyncImage.Path="{Binding ResumeImage}"/><Border Grid.Row="0" VerticalAlignment="Bottom" Background="#B00B0D12" Padding="12,8"><TextBlock Text="{Binding ResumeLabel}" FontSize="12" TextTrimming="CharacterEllipsis"/></Border><ProgressBar Grid.Row="0" VerticalAlignment="Bottom" Height="3" Margin="12,0" Value="{Binding Progress,Mode=OneWay}" Maximum="100" Foreground="{DynamicResource App.Text}"/><TextBlock Grid.Row="1" Text="{Binding Title}" FontWeight="SemiBold" Margin="0,12,0,0" TextTrimming="CharacterEllipsis"/></Grid></Button></DataTemplate>
</Window.Resources>
<Grid x:Name="Shell">
<Grid.RowDefinitions><RowDefinition x:Name="ChromeRow" Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Grid x:Name="Chrome" Background="#121315"><TextBlock Text="PCinema" Foreground="#999CA2" FontSize="11" Margin="16,0" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Content="&#xE921;" FontFamily="Segoe Fluent Icons" Padding="16,4" Margin="0" Background="Transparent" BorderThickness="0" Click="MinimizeWindow" ToolTip="Свернуть"/><Button Content="&#xE922;" FontFamily="Segoe Fluent Icons" Padding="16,4" Margin="0" Background="Transparent" BorderThickness="0" Click="MaximizeWindow" ToolTip="Развернуть"/><Button Content="&#xE8BB;" FontFamily="Segoe Fluent Icons" Padding="16,4" Margin="0" Background="Transparent" BorderThickness="0" Click="CloseWindow" ToolTip="Закрыть"/></StackPanel></Grid>
<Grid x:Name="Workspace" Grid.Row="1">
<ContentControl x:Name="HomeHost"><ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
<Grid Background="{DynamicResource App.Background}" ClipToBounds="True">
<!-- Canvas excludes artwork from measurement; width defines height through the image aspect ratio. -->
<Canvas x:Name="HomeBackground" IsHitTestVisible="False" ClipToBounds="True">
<Image x:Name="HomeArtwork" Width="{Binding ActualWidth,ElementName=HomeBackground}" local:AsyncImage.Path="{Binding Hero.Backdrop}" local:AsyncImage.Width="2560" Stretch="Uniform" Opacity="0.65">
<Image.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="White" Offset="0"/><GradientStop Color="White" Offset="0.55"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Image.OpacityMask>
</Image>
<Rectangle Width="{Binding ActualWidth,ElementName=HomeBackground}" Height="{Binding ActualHeight,ElementName=HomeArtwork}"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#B30B0D12" Offset="0"/><GradientStop Color="#000B0D12" Offset="0.7"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
</Canvas>
<StackPanel>
<Grid x:Name="HomeBanner" MinHeight="460">
<StackPanel Margin="48,80,40,24" VerticalAlignment="Top" MaxWidth="600" HorizontalAlignment="Left">

<Image local:AsyncImage.Path="{Binding Hero.Logo}" local:AsyncImage.Width="600" Height="72" MaxWidth="300" HorizontalAlignment="Left" Stretch="Uniform"><Image.Style><Style TargetType="Image"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Hero.Logo}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Image.Style></Image>
<TextBlock Text="{Binding HeroTitle}" FontSize="40" LineHeight="48" MaxHeight="96" TextTrimming="CharacterEllipsis" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,16"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Hero.Logo}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
<TextBlock Text="{Binding Hero.Details}" Foreground="#E0E0E0" FontSize="15" Margin="0,8,0,20"/>
<TextBlock Text="{Binding HeroOverview}" Foreground="#E3E3E4" FontSize="17" LineHeight="27" TextWrapping="Wrap" MaxHeight="72" TextTrimming="CharacterEllipsis"/>
<StackPanel Orientation="Horizontal" Margin="0,22,0,0"><Button Click="PlayHero" Style="{StaticResource PrimaryButton}"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE768;" Margin="0,0,10,0"/><TextBlock Text="{Binding HeroAction}"/></StackPanel></Button><Button Click="HeroInfo" Content="&#xE946;" ToolTip="О сериале"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource IconButton}"><Style.Triggers><DataTrigger Binding="{Binding Hero}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></StackPanel>
</StackPanel>
</Grid>
<StackPanel Margin="32,16,32,30">
<TextBlock Text="Продолжить просмотр" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,14"/>
<ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding Continuing}" ItemTemplate="{StaticResource ResumeCard}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></ScrollViewer>
<TextBlock Text="Здесь появятся сериалы, которые вы начали смотреть." Foreground="#94979E"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Continuing.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
<TextBlock Text="Недавно добавленные" FontSize="22" FontWeight="SemiBold" Margin="0,36,0,14"/>
<ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding Recent}" ItemTemplate="{StaticResource Card}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></ScrollViewer>
<TextBlock Text="Все сериалы" FontSize="22" FontWeight="SemiBold" Margin="0,32,0,14"/><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding Featured}" ItemTemplate="{StaticResource Card}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></ScrollViewer>
<Button Content="Открыть библиотеку →" Click="GoLibrary" HorizontalAlignment="Left" Margin="0,24,0,20"/>
<TextBlock Text="{Binding Status}" Foreground="#797D85" FontSize="12" Margin="0,12"/>
</StackPanel></StackPanel></Grid></ScrollViewer></ContentControl>
<ContentControl x:Name="PageHost" Visibility="Collapsed" Background="{DynamicResource App.Background}"/>
<Grid x:Name="Navigation" VerticalAlignment="Top" Margin="24,8,24,0" Height="44">
<Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel Orientation="Horizontal"><Button x:Name="BackButton" Style="{StaticResource NavigationButton}" Content="&#xE72B;" Click="BackClick" Visibility="Collapsed" ToolTip="Назад · Escape" AutomationProperties.Name="Назад"/>
<Button x:Name="HomeButton" Click="GoHome" Style="{StaticResource NavigationButton}" Width="156" ToolTip="Главная" AutomationProperties.Name="PCinema — главная"><StackPanel Orientation="Horizontal"><Image Source="Assets/pcinema-logo.png" Width="26" Height="26"/><TextBlock Text="PCINEMA" FontFamily="{DynamicResource App.Font}" FontSize="17" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel></Button></StackPanel>
<StackPanel Grid.Column="2" Orientation="Horizontal">
<Button Style="{StaticResource NavigationButton}" Content="&#xE721;" Click="GoLibrary" ToolTip="Поиск" AutomationProperties.Name="Поиск"/>
<Button x:Name="LibraryButton" Style="{StaticResource NavigationButton}" Content="&#xE8F1;" Click="GoLibrary" ToolTip="Библиотека" AutomationProperties.Name="Библиотека"/>
<Button x:Name="HistoryButton" Style="{StaticResource NavigationButton}" Content="&#xE81C;" Click="GoHistory" ToolTip="История" AutomationProperties.Name="История"/>
<Button x:Name="SettingsButton" Style="{StaticResource NavigationButton}" Content="&#xE713;" Click="Settings" ToolTip="Настройки" AutomationProperties.Name="Настройки"/>
<Button x:Name="AccountButton" Style="{StaticResource NavigationButton}" Content="&#xE77B;" Click="AccountSettings" ToolTip="Аккаунт и синхронизация" AutomationProperties.Name="Аккаунт и синхронизация"/>
</StackPanel></Grid>
<Grid x:Name="ModalLayer" Visibility="Collapsed" Background="#B0000000"><Border CornerRadius="24" Background="{DynamicResource App.Glass}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" Padding="30" Width="640" MaxHeight="{Binding ActualHeight,ElementName=ModalLayer}" HorizontalAlignment="Center" VerticalAlignment="Center"><DockPanel><Button DockPanel.Dock="Top" Content="Закрыть · Esc" Click="DismissModal" HorizontalAlignment="Right"/><ContentControl x:Name="ModalContent"/></DockPanel></Border></Grid>
</Grid></Grid></Window>

