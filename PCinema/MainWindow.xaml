<Window x:Class="PCinema.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PCinema" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Style="{StaticResource {x:Type Window}}" Title="PCinema" Icon="Assets/pcinema.ico" Width="1280" Height="860" MinWidth="850" MinHeight="600" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" PreviewKeyDown="KeyPressed">
<shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/></shell:WindowChrome.WindowChrome>
<Window.Resources>
<local:LocalImageConverter x:Key="LocalImage"/>
<DataTemplate x:Key="Card">
<Button Click="OpenSeries" Width="200" Height="300" Padding="0" Margin="0,8,16,14" Background="#25272B" ToolTip="{Binding Title}">
<Button.Template><ControlTemplate TargetType="Button">
<Grid x:Name="CardRoot" RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
<Border CornerRadius="12" ClipToBounds="True"><Border.Background><ImageBrush ImageSource="{Binding Poster,Converter={StaticResource LocalImage}}" Stretch="UniformToFill"/></Border.Background></Border>
<Border CornerRadius="12"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00202329" Offset="0"/><GradientStop Color="#E0101113" Offset="1"/></LinearGradientBrush></Border.Background><StackPanel VerticalAlignment="Bottom" Margin="14"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Subtitle}" Foreground="#B9BBBF" FontSize="12" Margin="0,6,0,0"/></StackPanel></Border>
<Border x:Name="Hover" CornerRadius="12" Background="#88000000" Opacity="0"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><Border Background="White" CornerRadius="30" Width="54" Height="54"><TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons" Foreground="Black" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Открыть сериал" Margin="0,12,0,0" FontSize="12"/></StackPanel></Border>
<ProgressBar Value="{Binding Progress,Mode=OneWay}" Height="3" Maximum="100" VerticalAlignment="Bottom" Margin="12,0,12,7" Foreground="White" Background="#30FFFFFF" BorderThickness="0"/>
</Grid>
<ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/><DoubleAnimation Storyboard.TargetName="CardRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.025" Duration="0:0:0.18"/><DoubleAnimation Storyboard.TargetName="CardRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.025" Duration="0:0:0.18"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/><DoubleAnimation Storyboard.TargetName="CardRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.18"/><DoubleAnimation Storyboard.TargetName="CardRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.18"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="1"/></Trigger></ControlTemplate.Triggers>
</ControlTemplate></Button.Template></Button></DataTemplate>
</Window.Resources>
<Grid x:Name="Shell">
<Grid.RowDefinitions><RowDefinition x:Name="ChromeRow" Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Grid x:Name="Chrome" Background="#121315"><TextBlock Text="PCinema" Foreground="#999CA2" FontSize="11" Margin="16,0" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Content="&#xE921;" FontFamily="Segoe Fluent Icons" Padding="16,4" Margin="0" Background="Transparent" BorderThickness="0" Click="MinimizeWindow" ToolTip="Свернуть"/><Button Content="&#xE922;" FontFamily="Segoe Fluent Icons" Padding="16,4" Margin="0" Background="Transparent" BorderThickness="0" Click="MaximizeWindow" ToolTip="Развернуть"/><Button Content="&#xE8BB;" FontFamily="Segoe Fluent Icons" Padding="16,4" Margin="0" Background="Transparent" BorderThickness="0" Click="CloseWindow" ToolTip="Закрыть"/></StackPanel></Grid>
<Grid Grid.Row="1">
<ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
<StackPanel>
<Grid Height="650">
<Image Source="{Binding Hero.Backdrop,Converter={StaticResource LocalImage},ConverterParameter=1600}" Stretch="UniformToFill"/>
<Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#D8101113" Offset="0"/><GradientStop Color="#50101113" Offset="0.65"/><GradientStop Color="#20101113" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
<Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00101113" Offset="0.4"/><GradientStop Color="#FF101113" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
<StackPanel Margin="64,150,50,70" VerticalAlignment="Center" MaxWidth="600" HorizontalAlignment="Left">
<TextBlock Text="ВАША ЛОКАЛЬНАЯ КОЛЛЕКЦИЯ" Foreground="#B3B5B8" FontSize="11" Margin="0,0,0,18"/>
<Image Source="{Binding Hero.Logo,Converter={StaticResource LocalImage},ConverterParameter=600}" Height="120" MaxWidth="360" HorizontalAlignment="Left" Stretch="Uniform"><Image.Style><Style TargetType="Image"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Hero.Logo}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Image.Style></Image>
<TextBlock Text="{Binding HeroTitle}" FontSize="48" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,16"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Hero.Logo}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
<TextBlock Text="{Binding Hero.Details}" Foreground="#E0E0E0" FontSize="15" Margin="0,8,0,20"/>
<TextBlock Text="{Binding HeroOverview}" Foreground="#E3E3E4" FontSize="17" LineHeight="27" TextWrapping="Wrap" MaxHeight="108" TextTrimming="CharacterEllipsis"/>
<StackPanel Orientation="Horizontal" Margin="0,22,0,0"><Button Click="PlayHero" Style="{StaticResource PrimaryButton}"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE768;" Margin="0,0,10,0"/><TextBlock Text="{Binding HeroAction}"/></StackPanel></Button><Button Click="HeroInfo" Style="{StaticResource IconButton}" Content="&#xE946;" ToolTip="О сериале"/><Button Content="Добавить папку" Click="AddFolder"/></StackPanel>
</StackPanel>
</Grid>
<StackPanel Margin="64,0,48,30">
<TextBlock Text="Продолжить просмотр" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,14"/>
<ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding Continuing}" ItemTemplate="{StaticResource Card}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></ScrollViewer>
<TextBlock Text="Здесь появятся сериалы, которые вы начали смотреть." Foreground="#94979E"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Continuing.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
<TextBlock Text="Недавно добавленные" FontSize="22" FontWeight="SemiBold" Margin="0,36,0,14"/>
<ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding Recent}" ItemTemplate="{StaticResource Card}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></ScrollViewer>
<Button Content="Все сериалы →" Click="GoLibrary" HorizontalAlignment="Left" Margin="0,24,0,20"/>
<TextBlock Text="{Binding Status}" Foreground="#797D85" FontSize="12" Margin="0,12"/>
</StackPanel></StackPanel></ScrollViewer>
<ContentControl x:Name="PageHost" Visibility="Collapsed" Background="#101113"/>
<Grid x:Name="Navigation" VerticalAlignment="Top" Margin="40,20,40,0">
<StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="BackButton" Style="{StaticResource IconButton}" Content="&#xE72B;" Click="BackClick" Visibility="Collapsed" ToolTip="Назад · Escape"/><Image Source="Assets/pcinema-logo.png" Width="36" Height="36" Margin="12,0,0,0"/><TextBlock Text="PCINEMA" FontSize="22" FontWeight="Bold" Margin="12,0" VerticalAlignment="Center"/></StackPanel>
<Border HorizontalAlignment="Right" Background="#B02D3034" CornerRadius="28" BorderBrush="#20FFFFFF" BorderThickness="1" Padding="5"><StackPanel Orientation="Horizontal"><Button x:Name="HomeButton" Content="Главная" Click="GoHome" Style="{StaticResource PrimaryButton}" Margin="0" Padding="22,10"/><Button x:Name="LibraryButton" Content="Библиотека" Click="GoLibrary" Background="Transparent" BorderThickness="0" Margin="2,0" Padding="22,10"/><Button Style="{StaticResource IconButton}" Content="&#xE721;" Click="GoLibrary" Background="Transparent" ToolTip="Поиск"/><Button Style="{StaticResource IconButton}" Content="&#xE713;" Click="Settings" Background="Transparent" ToolTip="Настройки"/></StackPanel></Border>
</Grid>
<Grid x:Name="ModalLayer" Visibility="Collapsed" Background="#B0000000"><Border CornerRadius="24" Background="#F0202227" BorderBrush="#30FFFFFF" BorderThickness="1" Padding="30" Width="640" MaxHeight="{Binding ActualHeight,ElementName=ModalLayer}" HorizontalAlignment="Center" VerticalAlignment="Center"><DockPanel><Button DockPanel.Dock="Top" Content="Закрыть · Esc" Click="DismissModal" HorizontalAlignment="Right"/><ContentControl x:Name="ModalContent"/></DockPanel></Border></Grid>
</Grid></Grid></Window>

